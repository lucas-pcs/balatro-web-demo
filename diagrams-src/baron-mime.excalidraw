    { "type": "text", "id": "note", "x": 90, "y": 480, "width": 1140, "height": 48, "text": "Growth is exponential in Kings held. Steel on each King adds another ×1.5 (also Mime-doubled). Per-hand static —\npair with relentless hand-leveling so the multiplied base keeps climbing every ante.", "originalText": "Growth is exponential in Kings held. Steel on each King adds another ×1.5 (also Mime-doubled). Per-hand static —\npair with relentless hand-leveling so the multiplied base keeps climbing every ante.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 200090, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.4 }
