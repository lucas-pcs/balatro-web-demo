    { "type": "text", "id": "note", "x": 130, "y": 500, "width": 1060, "height": 48, "text": "On a log axis, additive growth bends flat while ×Mult and retrigger stay straight, climbing lines. Past Ante ~5\nthe requirement outpaces every additive build — so the endgame is always a multiplicative / retrigger engine.", "originalText": "On a log axis, additive growth bends flat while ×Mult and retrigger stay straight, climbing lines. Past Ante ~5\nthe requirement outpaces every additive build — so the endgame is always a multiplicative / retrigger engine.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500040, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.4 }
