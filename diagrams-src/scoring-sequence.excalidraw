    { "type": "text", "id": "insight", "x": 80, "y": 470, "width": 1180, "height": 60, "text": "Why: a ×Mult joker multiplies the entire running Mult to its left. Put every +Chips and +Mult joker LEFT, every\n×Mult joker RIGHT — and a Polychrome (×1.5) on your right-most, biggest ×Mult.", "originalText": "Why: a ×Mult joker multiplies the entire running Mult to its left. Put every +Chips and +Mult joker LEFT, every\n×Mult joker RIGHT — and a Polychrome (×1.5) on your right-most, biggest ×Mult.", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100120, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.4 }
