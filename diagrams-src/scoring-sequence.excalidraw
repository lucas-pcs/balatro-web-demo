    { "type": "text", "id": "title", "x": 80, "y": 40, "width": 720, "height": 36, "text": "How a hand scores:  Chips × Mult", "originalText": "How a hand scores:  Chips × Mult", "fontSize": 28, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100001, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 80, "y": 82, "width": 900, "height": 24, "text": "Accumulators resolve left → right. ×Mult multiplies everything already in the pot — so order is everything.", "originalText": "Accumulators resolve left → right. ×Mult multiplies everything already in the pot — so order is everything.", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100002, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.25 },

